<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FluentSend.ViewModels"
             xmlns:fa="https://github.com/amwx/FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="FluentSend.Views.Pages.FilesPageView"
             x:DataType="vm:FilesPageViewModel">

    <Grid RowDefinitions="Auto, Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="24,8,24,16">
            <TextBlock Grid.Column="0" Text="接收历史" FontSize="24" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="清空历史"
                    Command="{Binding ClearHistoryCommand}"
                    Padding="16,8" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="24,0,24,8"
                IsVisible="{Binding HasHistory}">
            <TextBlock Text="双击列表项打开文件；右键可打开所在文件夹或删除记录。" Opacity="0.7" FontSize="12" />
        </Border>

        <Panel Grid.Row="2" Margin="24,0,24,12">
            <ListBox x:Name="FileList" ItemsSource="{Binding FileHistory}"
                     DoubleTapped="OnItemDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="40, *, Auto, Auto" Margin="4,8">
                            <PathIcon Grid.Column="0" Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z" Width="28" Height="28" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sender}" Opacity="0.6" FontSize="12" />
                                <TextBlock Text="{Binding Path}" Opacity="0.5" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                       VerticalAlignment="Center" Opacity="0.6"
                                       FontSize="12" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}"
                                       VerticalAlignment="Center" Opacity="0.7" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </ControlTheme>
                </ListBox.ItemContainerTheme>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开文件" Click="OnOpenFile" />
                        <MenuItem Header="打开所在文件夹" Click="OnOpenFolder" />
                        <Separator />
                        <MenuItem Header="从列表删除" Click="OnRemoveItem" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsVisible="{Binding IsEmpty}">
                <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"
                          Width="56" Height="56" Opacity="0.3" HorizontalAlignment="Center" />
                <TextBlock Text="还没有接收到任何文件" Opacity="0.6"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="接收到文件后会在这里显示历史记录" Opacity="0.4"
                           FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Panel>
    </Grid>
</UserControl>
