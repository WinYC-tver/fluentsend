<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FluentSend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:FluentSend.Views"
        xmlns:fa="https://github.com/amwx/FluentAvalonia"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
        x:Class="FluentSend.Views.MainWindow"
        Icon="/Assets/Icon.png"
        Title="FluentSend"
        MinWidth="420" MinHeight="500"
        Background="Transparent">

    <Panel>
        <views:MainView />
    </Panel>

</Window>
