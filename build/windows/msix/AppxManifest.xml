<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap3 rescap com desktop">

    <Identity Name="HZStudio.FluentSend"
              Publisher="CN=HZStudio, O=HZStudio, L=Beijing, S=Beijing, C=CN"
              Version="0.45.0.0"
              ProcessorArchitecture="x64" />

    <Properties>
        <DisplayName>FluentSend</DisplayName>
        <PublisherDisplayName>HZStudio</PublisherDisplayName>
        <Logo>Assets\Icon.png</Logo>
        <Description>你的最后一款文件传输软件 — 跨平台离线文件传输，兼容 LocalSend 协议</Description>
    </Properties>

    <Resources>
        <Resource Language="zh-CN" />
        <Resource Language="en-US" />
    </Resources>

    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22631.0" />
    </Dependencies>

    <Applications>
        <Application Id="FluentSend"
                     Executable="FluentSend.Desktop.exe"
                     EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="FluentSend"
                Description="跨平台离线文件传输软件，兼容 LocalSend 协议"
                BackgroundColor="transparent"
                Square150x150Logo="Assets\Icon.png"
                Square44x44Logo="Assets\Icon.png">
                <uap:DefaultTile Wide310x310Logo="Assets\Icon.png"
                                 Square310x310Logo="Assets\Icon.png"
                                 ShortName="FluentSend">
                    <uap:ShowNameOnTiles>
                        <uap:ShowOn Tile="square150x150Logo" />
                        <uap:ShowOn Tile="wide310x150Logo" />
                    </uap:ShowNameOnTiles>
                </uap:DefaultTile>
                <uap:SplashScreen Image="Assets\Icon.png" />
            </uap:VisualElements>
            <Extensions>
                <uap:Extension Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="anyfile">
                        <uap:SupportedFileTypes>
                            <uap:FileType ContentType="application/octet-stream">.*</uap:FileType>
                        </uap:SupportedFileTypes>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <desktop:Extension Category="windows.fullTrustProcess" />
            </Extensions>
        </Application>
    </Applications>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
        <Capability Name="internetClient" />
        <Capability Name="internetClientServer" />
        <Capability Name="privateNetworkClientServer" />
        <DeviceCapability Name="networking" />
    </Capabilities>
</Package>
